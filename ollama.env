# Runs the summaries on a local Ollama instead of the mock LLM:
#   docker compose --env-file ollama.env --profile ollama up --build
# The model is downloaded once (about 1.3 GB) and kept in the ollama-models volume.
CP_LLM_BASE_URL=http://ollama:11434/v1
CP_LLM_MODEL=llama3.2:1b
# The first call loads the model into memory, which is slow without a GPU.
CP_LLM_TIMEOUT_SECONDS=120
