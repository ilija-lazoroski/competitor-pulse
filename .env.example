# Copy to .env (git-ignored) and adjust, then point CP_CONFIG_PATH at it or export the values.
# All options and defaults: CONFIGURATION.md. Never put real secrets in this file.

CP_LOG_LEVEL=INFO
CP_DEBUG=false

# The API listens here. Use 0.0.0.0 inside Docker.
CP_BIND_ADDRESS=127.0.0.1
CP_PORT=8080

# PostgreSQL (required). The local development database; replace the password for anything else.
# If used in Docker add the service name instead of localhost
CP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/competitor_pulse
CP_DATABASE_POOL_MIN_SIZE=2
CP_DATABASE_POOL_MAX_SIZE=10
# Timeouts in seconds.
CP_DATABASE_CONNECT_TIMEOUT_SECONDS=5
CP_DATABASE_POOL_TIMEOUT_SECONDS=10
CP_DATABASE_PING_TIMEOUT_SECONDS=5
CP_DATABASE_RECONNECT_TIMEOUT_SECONDS=300
