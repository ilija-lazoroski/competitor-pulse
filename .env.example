# Copy to .env (git-ignored) and adjust, then point CP_CONFIG_PATH at it or export the values.
# All options and defaults: CONFIGURATION.md. Never put real secrets in this file.

CP_LOG_LEVEL=INFO
CP_DEBUG=false

# The API listens here. Use 0.0.0.0 inside Docker.
CP_BIND_ADDRESS=127.0.0.1
CP_PORT=8080

# PostgreSQL (required). The local development database; replace the password for anything else.
# If used in Docker add the service name instead of localhost
CP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/competitor_pulse
CP_DATABASE_POOL_MIN_SIZE=2
CP_DATABASE_POOL_MAX_SIZE=10
# Timeouts in seconds.
CP_DATABASE_CONNECT_TIMEOUT_SECONDS=5
CP_DATABASE_POOL_TIMEOUT_SECONDS=10
CP_DATABASE_PING_TIMEOUT_SECONDS=5
CP_DATABASE_RECONNECT_TIMEOUT_SECONDS=300

# Competitor API.
CP_API_RECENT_CHANGE_HOURS=24
CP_API_SNAPSHOTS_PAGE_SIZE=50
CP_API_SNAPSHOTS_MAX_PAGE_SIZE=200

# Listing source; the default is http://localhost:4002. Leave it commented out for Docker Compose,
# which reads this file too and otherwise points the poller at localhost inside its container.
# CP_SOURCE_BASE_URL=https://your-source.example
CP_SOURCE_TIMEOUT_SECONDS=10

# Poller. The source allows 5 requests per second in total; 4 leaves headroom.
CP_POLLER_INTERVAL_SECONDS=900
CP_POLLER_REQUESTS_PER_SECOND=4
CP_POLLER_MAX_IN_FLIGHT=50
CP_POLLER_CLAIM_BATCH_SIZE=10

# Cleaner: deletes snapshots older than the retention period, in short batches.
CP_CLEANER_RETENTION_DAYS=90
CP_CLEANER_INTERVAL_SECONDS=3600
CP_CLEANER_BATCH_SIZE=10000

# LLM: any OpenAI-compatible Chat Completions API. Docker Compose uses the mock LLM unless set;
# ollama.env switches to Ollama.
# The defaults are the mock LLM at http://localhost:4001/v1; leave these commented out for Docker
# Compose, for the same reason as the source URL.
# CP_LLM_BASE_URL=https://your-llm.example/v1
# CP_LLM_MODEL=your-model
# CP_LLM_API_KEY=your-key
CP_LLM_TIMEOUT_SECONDS=60
CP_LLM_MAX_ATTEMPTS=3
CP_LLM_DAILY_CAP=2000
